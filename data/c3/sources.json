  "bibliography_notes": [
    {
      "key": "kwok_tsou_chin_year_and_edition",
      "note_en": "Production records year 2005 for f005846b with empty authors and empty csl_data.issued. The file at hand is the web version of Yuè 粵 Dialects in the Encyclopedia of Chinese Language and Linguistics (Brill), DOI 10.1163/2210-7363_ecll_com_00000476; the edition is 2017, printed pp. 690–702, and the article cites pp. 692–693. The stored 2005 is a metadata defect, not a publication fact."
    },
    {
      "key": "stop_endings_year_and_attribution",
      "note_en": "Production records year 2000 for cf5ae16a, author 'Anne O. Yue'; earlier C3 material called this work 2002. The Appendix itself states that its classification is based on Yue 1988. The year needs checking against the volume."
    },
    {
      "key": "yue_hashimoto_1991a_vs_1991b",
      "note_en": "1991a is 余霭芹, 粤语方言分区问题初探, 方言 1991(3):164–181, production 69af2bca. 1991b is Anne Yue-Hashimoto, The Yue Dialect, JCL Monograph Series, production c8227da0, which is not part of the C3 slice. They are different works."
    },
    {
      "key": "atlas_editor_and_page_reference",
      "note_en": "The article cites the Atlas as 'Zhang Zhenxing, 2012: 185'; production lists five editors, and 185 is the physical PDF page whose printed number is 127. The card carries both fields."
    }
