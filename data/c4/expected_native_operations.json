        "a_start": "Position of the first record's quotation inside the source fragment (characters)",
        "a_end": "End position of the first record's quotation (characters)",
        "b_start": "Position of the second record's quotation inside the source fragment (characters)",
        "b_end": "End position of the second record's quotation (characters)",
        "relation": "same_evidence = both records cite the very same quotation; overlapping_span = separate but overlapping quotations"
      },
