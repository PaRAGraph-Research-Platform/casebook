{
  "name": "paragraph-casebook",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaRAGraph-Research-Platform/casebook.git"
  },
  "description": "Static offline viewer for the PaRAGraph Casebook companion artifact",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:single": "vite build --config vite.single.config.ts",
    "notice": "python3 scripts/make_notice.py"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-force-graph-2d": "^1.29.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
